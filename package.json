{
  "name": "dodge-code-reader",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host=0.0.0.0",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "icons": "python3 scripts/make_icons.py",
